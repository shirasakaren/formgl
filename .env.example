# ───────────────────────── Admin ─────────────────────────
# Passphrase required to enter /admin
ADMIN_PASSPHRASE=change-me-to-something-long
# Secret used to sign admin sessions (any long random string)
SESSION_SECRET=replace-with-a-long-random-string

# ───────────────────────── API (NestJS) ─────────────────────────
API_PORT=4000
# Comma separated list of allowed web origins (CORS)
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=postgres://formgl:formgl@localhost:5432/formgl
REDIS_URL=redis://localhost:6379
# Trust X-Forwarded-For from a reverse proxy (true when behind nginx / vercel / cloudflare)
TRUST_PROXY=true

# ───────────────────────── Storage (any S3 compatible) ─────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=formgl
S3_ACCESS_KEY=formgl
S3_SECRET_KEY=formgl-secret
# true for MinIO / most self-hosted providers
S3_FORCE_PATH_STYLE=true
# Max upload size in megabytes for respondent uploads
MAX_UPLOAD_MB=25

# ───────────────────────── Web (Next.js) ─────────────────────────
# Where the Next.js server reaches the API (server-side, rewrites)
API_INTERNAL_URL=http://localhost:4000
# Public site URL (used for share links / OG tags)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
