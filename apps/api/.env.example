# FormGL API environment.
# The API reads BOTH this folder's .env (apps/api/.env, takes precedence) AND the monorepo
# root .env (../../.env). For local dev it is usually enough to fill in the root .env only;
# use apps/api/.env for API-specific overrides. Real environment variables always win.

# Required: passphrase for /admin
ADMIN_PASSPHRASE=change-me-to-something-long
# Optional (reserved for future signing; sessions are random ids stored in Redis)
SESSION_SECRET=replace-with-a-long-random-string

API_PORT=4000
# comma separated list of allowed browser origins (CORS, credentials)
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=postgres://formgl:formgl@localhost:5432/formgl
REDIS_URL=redis://localhost:6379
# true | false | hop count | comma separated subnets (express "trust proxy").
# When enabled, CDN headers (cf-connecting-ip, cf-ipcountry, x-vercel-ip-*) are trusted too.
TRUST_PROXY=true

# Any S3 compatible storage (MinIO, R2, AWS, ...). Leave S3_ENDPOINT empty for AWS.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=formgl
S3_ACCESS_KEY=formgl
S3_SECRET_KEY=formgl-secret
S3_FORCE_PATH_STYLE=true
# max size of respondent uploads (MB); admin uploads are capped at 100 MB
MAX_UPLOAD_MB=25

# NODE_ENV=production   # enables Secure cookies
# SKIP_MIGRATIONS=true  # do not run migrations on boot
